# Housing Agent — environment variables
#
# This application is a self-contained demo: listings and agents are seed data
# in src/lib/seed.ts, and accounts live in the browser's localStorage. Nothing
# below is required to run it — `npm run dev` works with no .env file at all.
#
# Copy to `.env.local` and fill in if and when the app grows a backend.

# --- Site ---------------------------------------------------------------
# Absolute URL of the deployment, used for metadata and absolute links.
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Database (RDS: HM Land Registry sold prices) -------------------------
# Connection string for the RDS Postgres instance holding `sold_properties`
# (imported from S3 via aws_s3 — see /api/sold-properties,
# src/lib/postgres.ts). Never exposed to the browser — do NOT prefix with
# NEXT_PUBLIC_.
#
# Deliberately NOT named DATABASE_URL: this project also has a Neon Postgres
# instance whose env vars (POSTGRES_*, PG*, NEON_*) are auto-synced by a
# Vercel/Neon integration and would silently overwrite a plain DATABASE_URL
# on the next `vercel env pull`. RDS_DATABASE_URL is unrelated to that sync.
#
# Listings/accounts are unaffected either way: they stay in src/lib/seed.ts +
# localStorage.
RDS_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# --- Homedata live listings ---------------------------------------------
# Optional. Without it /properties/live explains that the feature is off and
# the rest of the app is unaffected. Sign up at https://homedata.co.uk to get
# a key; it is of the form "prefix.secret".
#
# Server-side only. Do NOT prefix this with NEXT_PUBLIC_ — that would inline
# the key into the client bundle, where anyone could lift it and spend your
# credit. It is read only by src/app/api/properties/route.ts.
#
# Billing note: Homedata charges per *listing returned*, not per request, so
# the route caps page_size and caches results.
# HOMEDATA_API_KEY=""

# --- EPC (Energy Performance Certificates) -------------------------------
# Optional. Without it, /api/epc explains that the feature is off and the
# rest of the app is unaffected. Register for developer access at
# https://epc.opendatacommunities.org/docs/api to get a token.
#
# Server-side only. Do NOT prefix this with NEXT_PUBLIC_ — that would inline
# the token into the client bundle. It is read only by src/app/api/epc/route.ts.
# EPC_API_TOKEN=""

# --- Mapbox -------------------------------------------------------------
# Optional. Without these the app falls back to a schematic map and the local
# outward-code table, so it still runs. With them you get real tiles, markers
# and postcode geocoding. Create a free account at https://account.mapbox.com
# and copy these into .env.local (which is git-ignored).
#
# Public token: readable by anyone who loads the page, because Mapbox GL JS
# authenticates from the browser. Create a dedicated (non-default) PUBLIC
# (pk.*) token and restrict it to your domains — production and localhost —
# under "URL restrictions" in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN="pk.your_public_token_here"
#
# Server token: used by /api/geocode so forward geocoding isn't billed
# against the public token strangers can lift out of the client bundle. A
# separate PUBLIC-scope (pk.*) token, not a secret (sk.*) one — Mapbox's
# geocoding v6 endpoint has no separate "geocoding" token scope to select,
# it just needs a valid token. Do NOT URL-restrict this one: server-side
# requests don't carry the browser Referer that URL restrictions check, so a
# restricted token gets rejected here. Splitting the tokens gives separate
# per-token usage stats and limits the blast radius if one leaks — it does
# not create separate billing, both still bill the same Mapbox account.
# Optional — the public token above is used if this is unset.
MAPBOX_SERVER_TOKEN="pk.your_separate_server_token_here"
#
# Optional style override. Defaults to mapbox://styles/mapbox/streets-v12,
# and switches to dark-v11 automatically in dark mode.
NEXT_PUBLIC_MAPBOX_STYLE="mapbox://styles/mapbox/streets-v12"
